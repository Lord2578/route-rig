{
  "expo": {
    "name": "RouteRig",
    "slug": "routerig",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon-main-1024.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.routerig.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111827",
        "foregroundImage": "./assets/icons/adaptive-foreground-1024.png",
        "backgroundImage": "./assets/icons/adaptive-background-1024.png",
        "monochromeImage": "./assets/icons/monochrome-1024.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.routerig.app"
    },
    "web": {
      "favicon": "./assets/icons/favicon-196.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "REPLACE_WITH_ANDROID_GOOGLE_MAPS_API_KEY"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RouteRig uses your location to center the map and calculate distance along your route.",
          "locationAlwaysAndWhenInUsePermission": "RouteRig uses your location, including in the background, to alert you when you're approaching your destination.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-task-manager",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111827",
          "image": "./assets/icons/splash-1024.png",
          "imageWidth": 220
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5d31b5c2-03c4-4c34-a1cc-7f17b432d327"
      }
    },
    "owner": "toru21"
  }
}
